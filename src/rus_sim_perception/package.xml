<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rus_sim_perception</name>
  <version>0.0.1</version>
  <description>感知层：点云预处理 → /preprocessed_cloud（planning 规划输入）；预留图像/超声/融合扩展</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rus_sim_interfaces</depend>
  <depend>rus_sim_utils</depend>
  <depend>pcl_conversions</depend>
  <depend>PCL</depend>
  <exec_depend>Eigen3</exec_depend>
  <!-- librealsense2：RealSense 直连数据源（source=realsense）。
       可选编译：-DRUS_SIM_WITH_REALSENSE=OFF 或未安装时自动降级为 stub，
       ros_topic / replay 数据源不受影响。 -->
  <depend>librealsense2</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
