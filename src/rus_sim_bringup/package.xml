<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rus_sim_bringup</name>
  <version>0.1.0</version>
  <description>RUS_Sim 整系统启动包：按顺序拉起桥接层（bridge）与驱动层（driver），通过 IncludeLaunchDescription 调用各包内部 launch</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rus_sim_bridge</exec_depend>
  <exec_depend>rus_sim_driver</exec_depend>
  <exec_depend>rus_sim_planning</exec_depend>
  <exec_depend>rus_sim_perception</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
